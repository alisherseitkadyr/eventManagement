NEXT_PUBLIC_API_MODE=mock

# Switch to `backend` when qonaq-backend is running.
# NEXT_PUBLIC_API_MODE=backend

# Browser requests go through Next.js rewrites in backend mode.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# Server-side rendering should also reach the backend directly.
# API_URL=http://127.0.0.1:8080

# Optional public app URL for invitation links.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
